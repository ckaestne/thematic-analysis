# thematic-analysis environment variables.
#
# Copy to .env (or export in your shell) and adjust as needed. Every variable
# below is optional and falls back to a sensible default — only LLM_API_KEY
# must be set for actual LLM calls to succeed.

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# API key for whichever provider matches LLM_MODEL (Anthropic, OpenAI,
# Gemini, etc.). Required for any real LLM call; tests stub the LLM out.
LLM_API_KEY=

# Optional non-default endpoint (proxy / self-hosted gateway / Bedrock URL).
# LLM_BASE_URL=https://...

# ---------------------------------------------------------------------------
# Global model selection (applies to every task unless overridden below)
# ---------------------------------------------------------------------------
# Any litellm-compatible id works: anthropic/..., openai/..., gemini/...,
# bedrock/..., openrouter/..., etc. Defaults to anthropic/claude-sonnet-4-6.
# LLM_MODEL=anthropic/claude-sonnet-4-6

# Global temperature / max output tokens defaults (used when no per-task
# override is set). Defaults: 0.7 temperature, 4096 max tokens.
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Per-task overrides (all optional)
# ---------------------------------------------------------------------------
# Tasks: CODER, AGGREGATOR, REVIEWER, THEME_CODER, SEGMENTER, TAILOR.
# Each LLM_<KEY>_<TASK> wins over LLM_<KEY>, which wins over the default.

# --- Model ---
# LLM_MODEL_CODER=anthropic/claude-opus-4-7
# LLM_MODEL_AGGREGATOR=anthropic/claude-haiku-4-5
# LLM_MODEL_REVIEWER=
# LLM_MODEL_THEME_CODER=
# LLM_MODEL_SEGMENTER=gemini/gemini-2.5-flash-lite
# LLM_MODEL_TAILOR=

# --- Temperature ---
# LLM_TEMPERATURE_CODER=0.7
# LLM_TEMPERATURE_AGGREGATOR=0.7
# LLM_TEMPERATURE_REVIEWER=0.2
# LLM_TEMPERATURE_THEME_CODER=0.7
# LLM_TEMPERATURE_SEGMENTER=0.0
# LLM_TEMPERATURE_TAILOR=0.7

# --- Max output tokens ---
# LLM_MAX_TOKENS_CODER=4096
# LLM_MAX_TOKENS_AGGREGATOR=4096
# LLM_MAX_TOKENS_REVIEWER=4096
# LLM_MAX_TOKENS_THEME_CODER=8192
# LLM_MAX_TOKENS_SEGMENTER=
# LLM_MAX_TOKENS_TAILOR=

# ---------------------------------------------------------------------------
# Retry tuning (transient errors: rate limits, 5xx, connection blips)
# ---------------------------------------------------------------------------
# LLM_RETRY_MAX_ATTEMPTS=6
# LLM_RETRY_BASE_DELAY=2.0
# LLM_RETRY_MAX_DELAY=60.0
